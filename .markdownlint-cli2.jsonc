{
  "globs": [
    "**/*.md"
  ],
  "ignores": [
    "node_modules",
    "dist",
    "coverage",
    "docs/**",
    ".alpheus/**",
    ".superpowers/**",
    "CHANGELOG.md"
  ],
  "config": {
    "default": true,
    "MD013": false,
    "MD024": false,
    "MD033": false,
    "MD041": false,
    "MD051": false
  }
}
